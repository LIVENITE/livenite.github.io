rules_version = '2';

// Paste this whole file into Firebase: Firestore Database > Rules > Publish.
// Anyone can read the prize, tonight's activities and the site settings. Only admins
// (people on the "managers" list) can change them, and the prize history can be added to but never edited or deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    // A manager is a logged-in user with a document at managers/<their user ID>.
    // Those documents are added by hand in the Firebase console (SETUP.md, step B6).
    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    function validPrize(d) {
      return d.amount is number && d.amount >= 0 && d.amount <= 10000000
        && d.ticketPrice is string && d.ticketPrice.size() <= 40
        && d.drawTime is string && d.drawTime.size() <= 40
        && d.updatedAt == request.time;
    }

    // The public prize record: no email, because anyone can read it.
    function validPublic() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount', 'ticketPrice', 'drawTime', 'updatedAt'])
        && validPrize(d);
    }

    // The managers-only history: also records who saved it.
    function validHistory() {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount', 'ticketPrice', 'drawTime', 'updatedAt', 'updatedBy'])
        && validPrize(d)
        && d.updatedBy == request.auth.token.email;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isManager() && validPublic();
      allow delete: if false;

      match /history/{entryId} {
        allow read: if isManager();
        allow create: if isManager() && validHistory();
        allow update, delete: if false;
      }
    }

    // Tonight's activities: anyone can read them, admins add, change and remove them.
    // Older activities may still carry "blurb" (the tagline before it was called "tag").
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function validActivity() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'type', 'venue', 'start', 'length', 'blurb', 'tag', 'host', 'style', 'graphic',
                               'hasManager', 'manager', 'winners', 'slots', 'resultsFinal', 'schedLength', 'updatedAt'])
        && d.keys().hasAll(['title', 'type', 'venue', 'start', 'length', 'host', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.type in ['game', 'music', 'social', 'challenge', 'draw', 'tickets']
        && d.venue is string && d.venue.size() > 0 && d.venue.size() <= 30
        && d.start is timestamp
        && d.length is int && d.length >= 1 && d.length <= 720
        && (!('schedLength' in d) || (d.schedLength is int && d.schedLength >= 1 && d.schedLength <= 720))
        && d.host is string && d.host.size() <= 60
        && optStr(d, 'blurb', 200) && optStr(d, 'tag', 80)
        && optStr(d, 'style', 20) && optStr(d, 'graphic', 20)
        && optBool(d, 'hasManager') && optStr(d, 'manager', 60)
        && optList(d, 'winners', 50) && optList(d, 'slots', 200) && optBool(d, 'resultsFinal')
        && d.updatedAt == request.time
        && timesInEvent(d);
    }

    // Event hours (site settings). Once they're set, an activity's start and end must stay inside them.
    // Saves that don't move an activity always pass, and one already outside may move toward the event
    // but not further out. Read "after" the write, so extending the event in the same save counts.
    function timesInEvent(d) {
      let path = /databases/$(database)/documents/site/settings;
      return unmoved(d) || !existsAfter(path) || !('eventStart' in getAfter(path).data) || insideOrCloser(d, getAfter(path).data);
    }
    function unmoved(d) { return resource != null && d.start == resource.data.start && d.length == resource.data.length; }
    function insideOrCloser(d, ev) {
      let end = d.start + duration.value(d.length, 'm');
      return (d.start >= ev.eventStart || (resource != null && d.start >= resource.data.start))
        && (end <= ev.eventEnd || (resource != null && end <= resource.data.start + duration.value(resource.data.length, 'm')));
    }

    // Only one 50/50. The record site/fiftyFifty names the activity that is the 50/50, and making an
    // activity the 50/50 (creating one, or changing its type) must claim that record in the same save.
    // An activity that's already the 50/50 can be saved as usual.
    function fiftyFiftyOk(activityId) {
      let lock = /databases/$(database)/documents/site/fiftyFifty;
      return request.resource.data.type != 'draw'
        || (resource != null && resource.data.type == 'draw')
        || (existsAfter(lock) && getAfter(lock).data.activityId == activityId);
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create, update: if isManager() && validActivity() && fiftyFiftyOk(activityId);
      allow delete: if isManager();
    }

    // The title section and menu admins edit: one public settings record.
    function validSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mark', 'eyebrow', 'brand', 'tagline', 'bulbs', 'nav', 'venues', 'eventStart', 'eventEnd', 'updatedAt'])
        && d.mark is string && d.mark.size() <= 24
        && d.eyebrow is string && d.eyebrow.size() <= 40
        && d.brand is string && d.brand.size() <= 24
        && d.tagline is string && d.tagline.size() <= 80
        && d.bulbs is bool
        && d.nav is list && d.nav.size() <= 12
        && (!('venues' in d) || (d.venues is list && d.venues.size() >= 1 && d.venues.size() <= 20))
        && validEventTimes(d)
        && d.updatedAt == request.time;
    }

    // Event start and end come as a pair; the event lasts at most 12 hours.
    function validEventTimes(d) {
      return (!('eventStart' in d) && !('eventEnd' in d))
        || (d.eventStart is timestamp && d.eventEnd is timestamp && d.eventEnd > d.eventStart
            && d.eventEnd <= d.eventStart + duration.value(12, 'h'));
    }

    // The 50/50 slot can move to a new activity only if the one it names is gone or no longer a 50/50.
    function validFiftyFifty() {
      let d = request.resource.data;
      return d.keys().hasOnly(['activityId', 'updatedAt']) && d.activityId is string && d.activityId.size() > 0
        && d.updatedAt == request.time
        && (resource == null || resource.data.activityId == d.activityId
            || !existsAfter(/databases/$(database)/documents/activities/$(resource.data.activityId))
            || getAfter(/databases/$(database)/documents/activities/$(resource.data.activityId)).data.type != 'draw');
    }

    match /site/{docId} {
      allow read: if true;
      allow create, update: if isManager() && ((docId == 'settings' && validSettings()) || (docId == 'fiftyFifty' && validFiftyFifty()));
      allow delete: if false;
    }

    // Each user may check whether they are on the list; nobody can change it from a page.
    match /managers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
